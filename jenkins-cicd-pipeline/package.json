{
  "name": "jenkins-demo-app",
  "version": "1.0.0",
  "description": "Sample Node.js web app built, tested and deployed by a Jenkins pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
